{
  "name": "joyerias-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "npm run dev --prefix server",
    "dev:all": "npm run ports:free && concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev\"",
    "ports:free": "for p in 3000 5173 5174; do lsof -ti :$p 2>/dev/null | xargs kill -9 2>/dev/null; done; echo Puertos 3000/5173/5174 liberados",
    "start": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
